{
  "name": "demowebshop-playwright",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "test": "playwright test",
    "test:ts": "playwright test typescript/",
    "test:js": "playwright test javascript/",
    "test:headed": "playwright test --headed",
    "test:chromium": "playwright test --project=chromium",
    "test:smoke": "playwright test --grep @smoke",
    "typecheck": "tsc --noEmit",
    "report": "playwright show-report",
    "report:allure": "allure generate allure-results && allure open allure-report",
    "report:allure:build": "allure generate allure-results"
  },
  "devDependencies": {
    "@playwright/test": "^1.48.0",
    "@types/node": "^22.0.0",
    "allure": "^3.20.0",
    "allure-playwright": "^3.13.0",
    "dotenv": "^16.4.5",
    "typescript": "^5.6.0"
  }
}
